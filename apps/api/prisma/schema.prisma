generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  BARISTA
}

enum ProductSize {
  S
  M
  L
}

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  E_WALLET
  CARD
}

enum PaymentStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  MANUAL_REVIEW
}

enum IngredientUnit {
  G
  ML
  PCS
}

enum ToppingType {
  PREPACKAGED
  PREPARED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponRedemptionStatus {
  RESERVED
  CONSUMED
  RELEASED
  EXPIRED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
  REVERSAL
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  username       String   @unique @db.VarChar(100)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  role           UserRole @default(CUSTOMER)
  loyaltyBalance Int      @default(0) @map("loyalty_balance")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders                      Order[]
  couponRedemptions           CouponRedemption[]
  loyaltyTransactions         LoyaltyTransaction[]
  changedOrderStatusHistories OrderStatusHistory[] @relation("OrderStatusChangedBy")

  @@map("users")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  imageUrl    String   @map("image_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants        ProductVariant[]
  productToppings ProductTopping[]

  @@index([isActive, createdAt])
  @@map("products")
}

// Một size của món pha chế. Không lưu số lượng thành phẩm: số ly có thể làm
// được luôn được tính từ công thức (RecipeItem) và tồn kho nguyên liệu.
model ProductVariant {
  id        String      @id @default(uuid()) @db.Uuid
  productId String      @map("product_id") @db.Uuid
  size      ProductSize
  price     BigInt
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]
  recipeItems           RecipeItem[]

  @@unique([productId, size])
  @@index([productId, isActive])
  @@map("product_variants")
}

// Nguyên liệu thô. stockQuantity tính theo đơn vị cơ sở của `unit`
// (G = gram, ML = mililit, PCS = cái), ví dụ 1 gói cà phê 100g = 100.
model Ingredient {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique @db.VarChar(50)
  name          String         @db.VarChar(100)
  unit          IngredientUnit
  stockQuantity Int            @map("stock_quantity")
  version       Int            @default(0)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipeItems        RecipeItem[]
  toppingRecipeItems ToppingRecipeItem[]
  reservationItems   InventoryReservationItem[]

  @@map("ingredients")
}

// Công thức (BOM): một ly của variant này cần `quantity` đơn vị cơ sở nguyên liệu.
model RecipeItem {
  productVariantId String @map("product_variant_id") @db.Uuid
  ingredientId     String @map("ingredient_id") @db.Uuid
  quantity         Int

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productVariantId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_items")
}

// Topping cũng không có số lượng tĩnh. Mỗi phần topping tiêu hao nguyên liệu theo
// công thức (ToppingRecipeItem):
//  - PREPACKAGED (nhập sẵn): 1 phần = đúng 1 dòng công thức, ví dụ 30g trân châu 3Q.
//  - PREPARED (chế biến): bán thành phẩm, 1 phần = nhiều nguyên liệu thô
//    (bột năng, đường đen, sữa tươi...).
model Topping {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique @db.VarChar(50)
  name      String      @db.VarChar(100)
  type      ToppingType @default(PREPACKAGED)
  price     BigInt
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  productToppings   ProductTopping[]
  orderItemToppings OrderItemTopping[]
  recipeItems       ToppingRecipeItem[]

  @@map("toppings")
}

// Công thức của 1 phần topping: tiêu hao `quantity` đơn vị cơ sở của nguyên liệu.
model ToppingRecipeItem {
  toppingId    String @map("topping_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid
  quantity     Int

  topping    Topping    @relation(fields: [toppingId], references: [id], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([toppingId, ingredientId])
  @@index([ingredientId])
  @@map("topping_recipe_items")
}

model ProductTopping {
  productId String @map("product_id") @db.Uuid
  toppingId String @map("topping_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  topping Topping @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([productId, toppingId])
  @@map("product_toppings")
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  orderNumber          String      @unique @map("order_number") @db.VarChar(30)
  userId               String      @map("user_id") @db.Uuid
  status               OrderStatus @default(PENDING)
  subtotal             BigInt
  discountAmount       BigInt      @default(0) @map("discount_amount")
  total                BigInt
  couponCodeSnapshot   String?     @map("coupon_code_snapshot") @db.VarChar(50)
  reservationExpiresAt DateTime    @map("reservation_expires_at") @db.Timestamptz(6)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  payments              Payment[]
  statusHistories       OrderStatusHistory[]
  inventoryReservations InventoryReservation[]
  couponRedemption      CouponRedemption?
  loyaltyTransactions   LoyaltyTransaction[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String @id @default(uuid()) @db.Uuid
  orderId             String @map("order_id") @db.Uuid
  productVariantId    String @map("product_variant_id") @db.Uuid
  productNameSnapshot String @map("product_name_snapshot") @db.VarChar(150)
  variantNameSnapshot String @map("variant_name_snapshot") @db.VarChar(50)
  unitPrice           BigInt @map("unit_price")
  quantity            Int
  sugarLevel          Int?   @map("sugar_level")
  iceLevel            Int?   @map("ice_level")
  note                String? @db.VarChar(500)

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant    ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  orderItemToppings OrderItemTopping[]

  @@map("order_items")
}

model OrderItemTopping {
  id                  String @id @default(uuid()) @db.Uuid
  orderItemId         String @map("order_item_id") @db.Uuid
  toppingId           String @map("topping_id") @db.Uuid
  toppingNameSnapshot String @map("topping_name_snapshot") @db.VarChar(100)
  unitPrice           BigInt @map("unit_price")
  quantity            Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  topping   Topping   @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@map("order_item_toppings")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @map("order_id") @db.Uuid
  idempotencyKey       String        @unique @map("idempotency_key") @db.VarChar(100)
  requestHash          String        @map("request_hash") @db.Char(64)
  method               PaymentMethod
  status               PaymentStatus @default(PROCESSING)
  amount               BigInt
  gatewayTransactionId String?       @unique @map("gateway_transaction_id") @db.VarChar(100)
  failureCode          String?       @map("failure_code") @db.VarChar(100)
  processedAt          DateTime?     @map("processed_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("payments")
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  reason          String?      @db.VarChar(255)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order         Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedByUser User? @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

model InventoryReservation {
  id               String            @id @default(uuid()) @db.Uuid
  orderId          String            @map("order_id") @db.Uuid
  productVariantId String            @map("product_variant_id") @db.Uuid
  quantity         Int
  status           ReservationStatus @default(ACTIVE)
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  order          Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant ProductVariant             @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  items          InventoryReservationItem[]

  @@unique([orderId, productVariantId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

// Lượng nguyên liệu thực tế đã giữ cho một reservation (snapshot theo công thức
// lúc đặt) để hoàn đúng số lượng khi hủy/hết hạn, kể cả khi công thức đổi sau đó.
model InventoryReservationItem {
  id            String @id @default(uuid()) @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  ingredientId  String @map("ingredient_id") @db.Uuid
  quantity      Int

  reservation InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  ingredient  Ingredient           @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([reservationId, ingredientId])
  @@index([ingredientId])
  @@map("inventory_reservation_items")
}

model Coupon {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique @db.VarChar(50)
  discountType  DiscountType @map("discount_type")
  discountValue BigInt       @map("discount_value")
  maxDiscount   BigInt?      @map("max_discount")
  minOrderValue BigInt       @default(0) @map("min_order_value")
  usageLimit    Int?         @map("usage_limit")
  perUserLimit  Int          @default(1) @map("per_user_limit")
  startsAt      DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime     @map("ends_at") @db.Timestamptz(6)
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id             String                 @id @default(uuid()) @db.Uuid
  couponId       String                 @map("coupon_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  orderId        String                 @unique @map("order_id") @db.Uuid
  discountAmount BigInt                 @map("discount_amount")
  status         CouponRedemptionStatus @default(RESERVED)
  expiresAt      DateTime               @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?              @map("consumed_at") @db.Timestamptz(6)
  releasedAt     DateTime?              @map("released_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId, status])
  @@index([status, expiresAt])
  @@map("coupon_redemptions")
}

model LoyaltyTransaction {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  orderId      String?                @map("order_id") @db.Uuid
  type         LoyaltyTransactionType
  points       Int
  balanceAfter Int                    @map("balance_after")
  reason       String                 @db.VarChar(255)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@map("loyalty_transactions")
}
